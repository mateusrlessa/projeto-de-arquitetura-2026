# Copie este arquivo para .env e ajuste os valores.

PORT=3001

# PostgreSQL. Se ficar vazio, o backend usa o PGlite (PostgreSQL embutido),
# salvo na pasta PGLITE_DIR, sem precisar instalar nada.
# Exemplo: postgres://usuario:senha@localhost:5432/cuidaaqui
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Segredo que assina os tokens JWT, com pelo menos 32 caracteres. Para gerar um:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Vazio em desenvolvimento: usa um segredo temporario. Em producao e obrigatorio.
JWT_SECRET=
TOKEN_ACESSO_EXPIRACAO=15m
SESSAO_DIAS=7

# ID do cliente OAuth do Google (termina em .apps.googleusercontent.com).
# Vazio: o botao do Google fica indisponivel. Veja como criar no README do backend.
GOOGLE_CLIENT_ID=

# Servidor SMTP que envia os links de confirmacao de e-mail e de recuperacao de senha.
# SMTP_HOST vazio em desenvolvimento: os links aparecem no log do servidor. Em producao e obrigatorio.
# Nao precisa ser um e-mail pessoal. Veja as opcoes na secao "Envio de e-mail" do README.
# Exemplo (Gmail com senha de app): SMTP_HOST=smtp.gmail.com, SMTP_PORTA=587, SMTP_USUARIO=seu@gmail.com,
# SMTP_SENHA=<senha de app de 16 letras>, EMAIL_REMETENTE=CuidaAqui <seu@gmail.com>
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=CuidaAqui <nao-responda@cuidaaqui.local>
# Endereco do site usado nos links dos e-mails. Em producao e obrigatorio.
FRONTEND_URL=http://localhost:5173
# Validade dos links, em minutos.
TOKEN_VERIFICACAO_MINUTOS=60
TOKEN_RECUPERACAO_MINUTOS=30

# Origens de navegador que podem chamar a API diretamente, separadas por virgula.
CORS_ORIGENS=http://localhost:5173
# Quantidade de proxies reversos na frente da API em producao (0 em desenvolvimento).
TRUST_PROXY=0

# Administrador criado automaticamente na primeira inicializacao (apenas para desenvolvimento).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@cuidaaqui.local
ADMIN_SENHA=Admin@12345

UPLOADS_DIR=./uploads

# Minutos, a partir do envio, em que o contratante pode editar ou excluir a propria avaliacao.
AVALIACAO_EDICAO_MINUTOS=10
